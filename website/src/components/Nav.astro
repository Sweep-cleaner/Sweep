---
---

<nav class="sticky top-0 z-50 backdrop-blur-xl bg-[#111219]/85 border-b border-border/50 transition-all">
  <div class="max-w-7xl mx-auto px-6 h-18 flex justify-between items-center">
    <!-- Logo & Title -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-rust to-cyan rounded-xl blur opacity-30 group-hover:opacity-70 transition duration-300"></div>
        <img src="/logo.jpg" alt="Sweep" class="relative h-9 w-9 rounded-xl object-cover shadow-sm" />
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-mono text-cyan font-bold tracking-tight text-xl">sweep</span>
        <span class="hidden sm:inline-block text-[11px] font-mono px-2 py-0.5 rounded-full bg-rust/10 border border-rust/30 text-rust font-semibold">
          v0.4.0
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-8 text-sm">
      <a href="#features" class="nav-link">Features</a>
      <a href="#demo" class="nav-link">CLI Playground</a>
      <a href="#themes" class="nav-link">GUI Themes</a>
      <a href="#benchmarks" class="nav-link">Benchmarks</a>
      <a href="#install" class="nav-link">Install</a>
      <a
        href="/docs"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan/10 border border-cyan/30 text-cyan hover:bg-cyan/20 hover:border-cyan font-medium transition-all"
      >
        <span>Documentation</span>
        <span class="text-[10px] bg-cyan/20 px-1 py-0.2 rounded font-mono">NEW</span>
      </a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/Sweep-cleaner/Sweep/releases/latest"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-xl bg-gradient-to-r from-cyan/20 to-cyan/5 border border-cyan/40 hover:border-cyan hover:shadow-[0_0_20px_-4px_rgba(127,219,202,0.5)] text-cyan transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" />
        </svg>
        <span class="hidden sm:inline">Download</span>
      </a>

      <a
        href="https://github.com/Sweep-cleaner/Sweep"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium rounded-xl bg-bg-surface hover:bg-bg-elevated border border-border/70 hover:border-cyan/50 text-text-primary transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
        <span class="text-text-dim text-[11px]">★ Star</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="nav-mobile-btn"
        class="md:hidden p-2 text-text-muted hover:text-white rounded-lg hover:bg-white/5"
        aria-label="Open Mobile Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-border/50 bg-[#141520] px-6 py-4 space-y-3">
    <a href="#features" class="block py-2 text-text-primary hover:text-cyan font-medium">Features</a>
    <a href="#demo" class="block py-2 text-text-primary hover:text-cyan font-medium">CLI Playground</a>
    <a href="#themes" class="block py-2 text-text-primary hover:text-cyan font-medium">GUI Themes</a>
    <a href="#benchmarks" class="block py-2 text-text-primary hover:text-cyan font-medium">Benchmarks</a>
    <a href="#install" class="block py-2 text-text-primary hover:text-cyan font-medium">Install</a>
    <a href="/docs" class="block py-2 text-cyan font-semibold flex items-center justify-between">
      <span>Documentation Hub</span>
      <span class="text-xs bg-cyan/20 px-2 py-0.5 rounded font-mono">/docs</span>
    </a>
    <div class="pt-3 border-t border-border/40 space-y-2">
      <a
        href="https://github.com/Sweep-cleaner/Sweep/releases/latest"
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-cyan/10 border border-cyan/40 text-sm font-semibold text-cyan"
      >
        <span>↓ Download v0.4.0</span>
      </a>
      <a
        href="https://github.com/Sweep-cleaner/Sweep"
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-bg-surface border border-border text-sm font-medium text-white"
      >
        <span>View on GitHub</span>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  const mobileBtn = document.getElementById('nav-mobile-btn');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
