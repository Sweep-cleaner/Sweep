---
import TerminalAnimation from './TerminalAnimation.tsx';
---

<section id="hero" class="relative pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-gradient-to-tr from-cyan/15 via-rust/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-5xl mx-auto px-6 text-center">
    <!-- Announcement Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-bg-surface/80 border border-border/80 text-xs text-text-primary mb-8 backdrop-blur-md shadow-sm hover:border-cyan/50 transition-colors">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan"></span>
      </span>
      <span class="font-mono text-cyan font-semibold">Sweep v0.4.0</span>
      <span class="text-text-dim">|</span>
      <span class="text-text-muted">The Independent Rust System Cleaner</span>
      <a href="/docs" class="text-rust hover:underline ml-1 font-medium">Read Docs →</a>
    </div>

    <!-- Central Logo with Pulse Glow -->
    <div class="flex justify-center mb-6">
      <div class="relative group">
        <div class="absolute -inset-2 bg-gradient-to-r from-rust via-cyan to-rust rounded-3xl blur-xl opacity-40 group-hover:opacity-75 transition duration-500 animate-pulse"></div>
        <img
          src="/logo.jpg"
          alt="Sweep Logo"
          class="relative h-24 w-24 md:h-32 md:w-32 rounded-3xl object-cover shadow-2xl border border-white/10"
        />
      </div>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-tight sm:leading-none">
      <span class="block bg-gradient-to-r from-white via-text-primary to-text-muted bg-clip-text text-transparent">
        Blazing-Fast.
      </span>
      <span class="block bg-gradient-to-r from-cyan via-[#9ece6a] to-cyan bg-clip-text text-transparent mt-1">
        Memory-Safe.
      </span>
      <span class="block bg-gradient-to-r from-rust to-rust-glow bg-clip-text text-transparent mt-1">
        6.0 MB.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-xl text-text-muted mt-8 max-w-3xl mx-auto leading-relaxed font-normal">
      The ultimate open-source system cleaner written in <span class="text-rust font-semibold">Rust</span>. Zero telemetry, <span class="text-cyan font-semibold">202</span> native cleaners, parallel multi-core scanning, a fail-closed safety engine, and a Qt6/QML desktop shell.
    </p>

    <!-- Quick Copy Command Pill -->
    <div class="mt-8 flex flex-col items-center gap-2">
      <div class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl bg-[#13141f] border border-border/80 shadow-inner group">
        <span class="text-rust font-mono text-xs select-none">$</span>
        <code id="hero-cmd-text" class="text-xs sm:text-sm font-mono text-cyan">sweep preview --all</code>
        <button
          type="button"
          id="hero-copy-btn"
          class="text-xs font-mono px-2 py-1 rounded bg-bg-surface hover:bg-bg-elevated border border-border text-text-dim hover:text-white transition-all cursor-pointer"
        >
          Copy
        </button>
      </div>
      <span class="text-[11px] font-mono text-text-dim">
        Shipped as an AppImage, a Windows Setup.exe and a portable tarball —
        <a href="#install" class="text-cyan hover:underline">see downloads</a>
      </span>
    </div>

    <!-- Action Buttons -->
    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="/docs" class="btn-primary w-full sm:w-auto text-sm">
        <span>📖 Explore Documentation</span>
      </a>
      <a href="#install" class="btn-secondary w-full sm:w-auto text-sm">
        <span>⚡ Quick Install</span>
      </a>
      <a
        href="https://github.com/Sweep-cleaner/Sweep"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-bg-surface/80 hover:bg-bg-elevated border border-border/70 text-text-muted hover:text-white text-sm font-medium transition-all w-full sm:w-auto"
      >
        <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub Repository</span>
      </a>
    </div>

    <!-- Feature Metric Pills -->
    <div class="mt-12 pt-8 border-t border-border/40 max-w-4xl mx-auto">
      <div class="text-center mb-4">
        <span class="text-[11px] font-mono text-text-dim">
          Benchmarked on <span class="text-cyan font-semibold">Sweep v0.2.5</span>
          <span class="text-border">·</span>
          Ubuntu 22.04 · Ryzen 7 5700U · NVMe SSD
        </span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center p-3 rounded-xl bg-white/[0.02] border border-border/30">
          <div class="text-xl md:text-2xl font-mono font-bold text-cyan">4.85s</div>
          <div class="text-xs text-text-dim mt-1 font-mono">12k File System Scan</div>
        </div>
        <div class="text-center p-3 rounded-xl bg-white/[0.02] border border-border/30">
          <div class="text-xl md:text-2xl font-mono font-bold text-rust">6.0 MB</div>
          <div class="text-xs text-text-dim mt-1 font-mono">Single Release Binary</div>
        </div>
        <div class="text-center p-3 rounded-xl bg-white/[0.02] border border-border/30">
          <div class="text-xl md:text-2xl font-mono font-bold text-white">202</div>
          <div class="text-xs text-text-dim mt-1 font-mono">Built-in Cleaners</div>
        </div>
        <div class="text-center p-3 rounded-xl bg-white/[0.02] border border-border/30">
          <div class="text-xl md:text-2xl font-mono font-bold text-[#9ece6a]">0%</div>
          <div class="text-xs text-text-dim mt-1 font-mono">Telemetry or Ads</div>
        </div>
      </div>
    </div>

    <!-- Interactive Terminal Showcase -->
    <TerminalAnimation client:visible />
  </div>
</section>

<script is:inline>
  const copyBtn = document.getElementById('hero-copy-btn');
  const cmdText = document.getElementById('hero-cmd-text');
  copyBtn?.addEventListener('click', async () => {
    if (!cmdText) return;
    try {
      await navigator.clipboard.writeText(cmdText.innerText);
      copyBtn.innerText = 'Copied!';
      copyBtn.classList.add('text-cyan', 'border-cyan');
      setTimeout(() => {
        copyBtn.innerText = 'Copy';
        copyBtn.classList.remove('text-cyan', 'border-cyan');
      }, 2000);
    } catch (e) {
      copyBtn.innerText = 'Failed';
    }
  });
</script>
