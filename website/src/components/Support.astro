---
---

<section id="support" class="section">
  <div class="max-w-4xl mx-auto rounded-3xl bg-gradient-to-b from-[#181928] to-[#12131e] border border-border/80 p-8 sm:p-12 text-center relative overflow-hidden shadow-2xl">
    <!-- Ambient glow inside card -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-rust/15 rounded-full blur-3xl pointer-events-none"></div>

    <p class="section-kicker">// OPEN SOURCE &amp; COMMUNITY</p>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
      Keep Sweep Free, Safe &amp; Independent
    </h2>

    <p class="text-text-muted text-base sm:text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
      Sweep is 100% free, released under the <span class="text-cyan font-mono text-xs bg-cyan/10 border border-cyan/30 px-2.5 py-1 rounded-md font-semibold">GPL v3.0 License</span>, completely free of telemetry or adware, and actively developed by an independent team.
    </p>

    <div class="flex gap-4 justify-center flex-wrap mb-8">
      <a
        href="https://github.com/Sweep-cleaner/Sweep"
        target="_blank"
        rel="noopener"
        class="btn-primary text-sm shadow-glow-rust"
      >
        <span>★ Star on GitHub</span>
      </a>
      <a
        href="https://github.com/sponsors/Sweep-cleaner"
        target="_blank"
        rel="noopener"
        class="btn-secondary text-sm shadow-glow-cyan"
      >
        <span>💜 Sponsor the Project</span>
      </a>
    </div>

    <div class="inline-flex items-center gap-3 text-xs text-text-dim border-t border-border/40 pt-6">
      <span>Built with Rust 🦀</span>
      <span>•</span>
      <span>No Tracking</span>
      <span>•</span>
      <span>Open Source Forever</span>
    </div>
  </div>
</section>
