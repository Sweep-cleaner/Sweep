---
const commands = [
  { title: 'sweep residue scan', description: 'Confidence-scored leftover and dead-output scan.', full: 'sweep residue scan --confidence 0.7' },
  { title: 'sweep devscan', description: 'Clean node_modules, target, build dirs.', full: 'sweep devscan ~/projects' },
  { title: 'sweep sysinfo --health', description: 'CPU, disk, temperature and SMART verdict.', full: 'sweep sysinfo --health' },
  { title: 'sweep memopt', description: 'Native memory optimization (dry-run first).', full: 'sweep memopt --aggressive --dry-run' },
  { title: 'sweep bigfiles', description: 'Hunt space hogs by size and age.', full: 'sweep bigfiles --min-size 500MB --older-than 90d' },
  { title: 'sweep undo', description: 'Restore from the operation log.', full: 'sweep undo' }
];
---
<section id="commands" class="section bg-bg-surface/30">
  <p class="section-kicker">// CLI</p>
  <h2 class="text-4xl md:text-5xl font-bold text-center mb-4">Power at Your Fingertips.</h2>
  <p class="text-text-muted text-center text-lg mb-12">One CLI. Every byte. Reclaimed.</p>
  <div class="grid md:grid-cols-2 gap-6">
    {commands.map(cmd => (
      <div>
        <h3 class="text-lg font-mono text-cyan mb-3">{cmd.title}</h3>
        <p class="text-text-muted text-sm mb-4">{cmd.description}</p>
        <div class="code-block flex items-center justify-between gap-4">
          <code class="flex-1 overflow-x-auto"><span class="text-rust">$ </span>{cmd.full}</code>
          <button type="button" class="shrink-0 text-xs text-text-dim hover:text-cyan transition-colors px-2 py-1 rounded border border-border hover:border-cyan">Copy</button>
        </div>
      </div>
    ))}
  </div>
</section>
