---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  toc?: { id: string; title: string }[];
  prevPage?: { title: string; href: string };
  nextPage?: { title: string; href: string };
}

const {
  title,
  description = 'Sweep Documentation — Blazing-Fast, Memory-Safe Rust System Cleaner',
  currentSlug = 'index',
  toc = [],
  prevPage,
  nextPage
} = Astro.props;

const docGroups = [
  {
    title: 'Getting Started',
    items: [
      { slug: 'index', title: 'Overview & Philosophy', icon: '📖', href: '/docs' },
      { slug: 'installation', title: 'Installation Guide', icon: '⚡', href: '/docs/installation' }
    ]
  },
  {
    title: 'Usage Guide',
    items: [
      { slug: 'cli', title: 'CLI Reference & Commands', icon: '💻', href: '/docs/cli' },
      { slug: 'gui', title: 'Qt6/QML GUI & Themes', icon: '🎨', href: '/docs/gui' },
      { slug: 'system-tools', title: 'Memory, Startup & Health', icon: '🧠', href: '/docs/system-tools' },
      { slug: 'automation', title: 'Scheduling & Snapshots', icon: '⏱️', href: '/docs/automation' }
    ]
  },
  {
    title: 'Disk & Data',
    items: [
      { slug: 'disk-intelligence', title: 'Disk Intelligence Tools', icon: '💾', href: '/docs/disk-intelligence' },
      { slug: 'residue', title: 'Residue Engine', icon: '🔬', href: '/docs/residue' }
    ]
  },
  {
    title: 'Architecture & Rules',
    items: [
      { slug: 'safety', title: 'Safety Model', icon: '🛡️', href: '/docs/safety' },
      { slug: 'cleaners', title: 'TOML Cleaner Authoring', icon: '🔧', href: '/docs/cleaners' },
      { slug: 'configuration', title: 'Configuration Reference', icon: '⚙️', href: '/docs/configuration' }
    ]
  },
  {
    title: 'Technical Proof',
    items: [
      { slug: 'benchmarks', title: 'Benchmarks & Matrix', icon: '📊', href: '/docs/benchmarks' }
    ]
  }
];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111219" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <title>{title} — Sweep Docs</title>
  </head>
  <body class="bg-[#111219] text-text-primary antialiased selection:bg-rust/30 selection:text-white min-h-screen flex flex-col">
    <!-- Top Docs Navigation Bar -->
    <header class="sticky top-0 z-40 w-full border-b border-border/60 bg-[#111219]/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <button
            type="button"
            id="mobile-sidebar-toggle"
            class="md:hidden p-2 text-text-muted hover:text-white rounded-lg hover:bg-white/5"
            aria-label="Toggle Navigation"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <a href="/" class="flex items-center gap-2.5 group">
            <img src="/logo.jpg" alt="Sweep" class="h-8 w-8 rounded-lg shadow-sm group-hover:scale-105 transition-transform" />
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-cyan font-bold tracking-tight text-lg">sweep</span>
              <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-rust/10 border border-rust/30 text-rust font-semibold">docs</span>
            </div>
          </a>

          <div class="hidden sm:flex items-center text-xs text-text-dim gap-2 border-l border-border/60 pl-4">
            <a href="/" class="hover:text-text-muted transition-colors">Home</a>
            <span>/</span>
            <span class="text-cyan font-medium">Docs</span>
            <span>/</span>
            <span class="text-text-primary truncate max-w-[200px]">{title}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-cyan px-3 py-1.5 rounded-lg border border-border/50 hover:border-cyan/40 bg-white/5 transition-all"
          >
            ← Back to Home
          </a>

          <a
            href="https://github.com/Sweep-cleaner/Sweep"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-xs text-text-primary hover:text-white px-3 py-1.5 rounded-lg bg-bg-surface border border-border/70 hover:border-cyan transition-all"
          >
            <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span class="hidden md:inline">GitHub</span>
            <span class="text-[10px] bg-cyan/20 text-cyan px-1.5 py-0.2 rounded font-mono">v0.4.0</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Docs Shell Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex-1 w-full flex">
      <!-- Mobile Sidebar Overlay Backdrop -->
      <div id="mobile-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden md:hidden"></div>

      <!-- Docs Sidebar -->
      <aside
        id="docs-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-72 bg-[#141520] md:bg-transparent border-r border-border/60 p-6 overflow-y-auto transform -translate-x-full md:translate-x-0 md:static md:w-64 lg:w-72 md:shrink-0 transition-transform duration-200 ease-in-out mt-16 md:mt-0"
      >
        <!-- Sidebar Search / Filter -->
        <div class="mb-6">
          <div class="relative">
            <input
              type="text"
              id="docs-search-input"
              placeholder="Filter topics..."
              class="w-full bg-[#1b1c2b] border border-border/70 rounded-lg pl-9 pr-3 py-2 text-xs text-text-primary placeholder:text-text-dim focus:outline-none focus:border-cyan transition-colors"
            />
            <svg class="w-4 h-4 text-text-dim absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <nav class="space-y-6" id="docs-nav-tree">
          {docGroups.map(group => (
            <div class="doc-group">
              <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-text-dim mb-2.5 px-2">
                {group.title}
              </h4>
              <ul class="space-y-1">
                {group.items.map(item => {
                  const isActive = currentSlug === item.slug;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all doc-nav-item',
                          isActive
                            ? 'bg-cyan/15 text-cyan font-semibold border-l-2 border-cyan shadow-sm'
                            : 'text-text-muted hover:text-text-primary hover:bg-white/5'
                        ]}
                        data-title={item.title.toLowerCase()}
                      >
                        <span class="text-base">{item.icon}</span>
                        <span class="flex-1 truncate">{item.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}

          <div class="pt-4 border-t border-border/40">
            <div class="p-3 bg-rust/5 border border-rust/20 rounded-xl">
              <div class="flex items-center gap-2 text-xs font-semibold text-rust mb-1">
                <span>🛡️</span>
                <span>Safety First</span>
              </div>
              <p class="text-[11px] text-text-dim leading-relaxed">
                All destructive operations require explicit confirmation. Use <code class="text-cyan">--preview</code> on any command.
              </p>
            </div>
          </div>
        </nav>
      </aside>

      <!-- Main Docs Content Area -->
      <main class="flex-1 min-w-0 py-10 md:px-8 lg:px-12">
        <div class="max-w-4xl mx-auto">
          <!-- Page Header -->
          <div class="mb-10 pb-6 border-b border-border/50">
            <div class="flex items-center gap-2 mb-2">
              <span class="section-kicker !text-left !mb-0">// DOCUMENTATION</span>
              <span class="text-text-dim text-xs">/</span>
              <span class="text-xs font-mono text-rust">Sweep v0.4.0</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
              {title}
            </h1>
            {description && (
              <p class="text-lg text-text-muted leading-relaxed">
                {description}
              </p>
            )}
          </div>

          <!-- Dynamic Article Content -->
          <article class="prose prose-invert max-w-none text-text-primary leading-relaxed space-y-6">
            <slot />
          </article>

          <!-- Bottom Navigation (Prev / Next) -->
          <div class="mt-16 pt-8 border-t border-border/60 flex flex-col sm:flex-row items-center justify-between gap-4">
            {prevPage ? (
              <a
                href={prevPage.href}
                class="w-full sm:w-auto inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-border/70 hover:border-cyan/50 bg-bg-surface hover:bg-bg-elevated transition-all group text-sm"
              >
                <span class="text-cyan group-hover:-translate-x-1 transition-transform">←</span>
                <div>
                  <div class="text-[10px] uppercase font-mono text-text-dim">Previous</div>
                  <div class="font-medium text-text-primary group-hover:text-cyan transition-colors">{prevPage.title}</div>
                </div>
              </a>
            ) : <div class="hidden sm:block"></div>}

            {nextPage ? (
              <a
                href={nextPage.href}
                class="w-full sm:w-auto inline-flex items-center justify-end gap-2 px-5 py-3 rounded-xl border border-border/70 hover:border-cyan/50 bg-bg-surface hover:bg-bg-elevated transition-all group text-sm ml-auto text-right"
              >
                <div>
                  <div class="text-[10px] uppercase font-mono text-text-dim">Next</div>
                  <div class="font-medium text-text-primary group-hover:text-cyan transition-colors">{nextPage.title}</div>
                </div>
                <span class="text-cyan group-hover:translate-x-1 transition-transform">→</span>
              </a>
            ) : null}
          </div>

          <!-- Documentation Footer Note -->
          <div class="mt-12 p-4 rounded-xl bg-white/[0.02] border border-border/40 text-xs text-text-dim flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>
              Found an error or missing documentation? Open a PR on the
              <a href="https://github.com/Sweep-cleaner/Sweep" target="_blank" rel="noopener" class="text-cyan hover:underline ml-1">GitHub repository</a>.
            </p>
            <a href="#top" class="text-text-muted hover:text-cyan shrink-0 transition-colors">Back to top ↑</a>
          </div>
        </div>
      </main>

      <!-- Right On-Page Table of Contents (Desktop) -->
      {toc && toc.length > 0 && (
        <aside class="hidden xl:block w-60 shrink-0 py-10 pl-6 border-l border-border/40 text-xs">
          <div class="sticky top-24">
            <h5 class="font-mono text-text-dim uppercase tracking-wider font-semibold mb-3">On This Page</h5>
            <ul class="space-y-2.5">
              {toc.map(item => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block text-text-muted hover:text-cyan transition-colors truncate"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>

    <!-- Client Script for Interactive Docs Features -->
    <script is:inline>
      // 1. Mobile Sidebar Toggle
      const toggleBtn = document.getElementById('mobile-sidebar-toggle');
      const sidebar = document.getElementById('docs-sidebar');
      const overlay = document.getElementById('mobile-overlay');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
      }
      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      }

      toggleBtn?.addEventListener('click', () => {
        if (sidebar?.classList.contains('-translate-x-full')) {
          openSidebar();
        } else {
          closeSidebar();
        }
      });
      overlay?.addEventListener('click', closeSidebar);

      // 2. Sidebar Topic Filtering
      const searchInput = document.getElementById('docs-search-input');
      const navItems = document.querySelectorAll('.doc-nav-item');
      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        navItems.forEach(item => {
          const title = item.getAttribute('data-title') || '';
          if (!query || title.includes(query)) {
            item.parentElement.style.display = '';
          } else {
            item.parentElement.style.display = 'none';
          }
        });
      });

      // 3. Code Block Copy Buttons
      document.querySelectorAll('pre').forEach(pre => {
        if (pre.querySelector('.copy-code-btn')) return;
        pre.classList.add('relative', 'group');
        
        const btn = document.createElement('button');
        btn.className = 'copy-code-btn absolute top-3 right-3 text-[11px] font-mono px-2.5 py-1 rounded bg-bg-surface/80 border border-border text-text-dim hover:text-cyan hover:border-cyan transition-all opacity-0 group-hover:opacity-100 shadow-sm cursor-pointer';
        btn.textContent = 'Copy';

        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(code.replace(/^(\$|>)\s+/gm, ''));
            btn.textContent = 'Copied!';
            btn.classList.add('text-cyan', 'border-cyan');
            setTimeout(() => {
              btn.textContent = 'Copy';
              btn.classList.remove('text-cyan', 'border-cyan');
            }, 2000);
          } catch (err) {
            btn.textContent = 'Failed';
          }
        });

        pre.appendChild(btn);
      });
    </script>
  </body>
</html>
