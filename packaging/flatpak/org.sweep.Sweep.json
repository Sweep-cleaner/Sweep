{
  "app-id": "org.sweep.Sweep",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "sweep",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--filesystem=host-reset",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "sweep",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/sweep-cleaner/sweep/archive/v0.1.0.tar.gz",
          "sha256": "REPLACE_WITH_RELEASE_SHA256"
        }
      ],
      "build-commands": [
        "cargo build --release --locked --offline || cargo build --release --locked",
        "install -Dm755 target/release/sweep /app/bin/sweep"
      ]
    }
  ]
}
