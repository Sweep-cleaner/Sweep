#compdef sweep
# zsh completion for sweep
# Generated by `sweep completions zsh` - regenerate after CLI changes.
_sweep() {
    local -a _sweep_commands
    _sweep_commands=(
        'list:List cleaners and their options'
        'info:Show everything Sweep knows about one cleaner (definition detail)'
        'preview:Preview what would be cleaned (no changes are made)'
        'clean:Clean (actually deletes files)'
        'deepscan:Deep-scan directories for junk by name pattern'
        'leftovers:Find leftover files of an (uninstalled) app by name'
        'devscan:Find regenerable developer cruft (node_modules, target, __pycache__...)'
        'bigfiles:Find the largest files above a size threshold, biggest first'
        'dupes:Find duplicate files by size + content hash'
        'wipe:Overwrite free space on the volume containing a path'
        'schedule:Manage the scheduled cleanup timer (Linux + systemd)'
        'undo:Restore files deleted with --backup-dir, using the operation log'
        'update-winapp2:Download and validate the community winapp2.ini rules'
        'hub:Manage community cleaner rules (list/install/remove/update)'
        'shred:Securely shred files (overwrite then delete)'
        'analyze:Analyze disk usage (read-only directory + file ranking)'
        'startup:Manage XDG autostart entries'
        'services:Manage systemd services'
        'doctor:Diagnose config, tools, permissions, disk and systemd'
        'memopt:Optimize memory (drop unused page cache; Linux + root)'
        'snapshot:Manage filesystem snapshots (snapper/timeshift)'
        'history:Show cleaning history from the operation log'
        'watch:Watch disk usage and notify when a threshold is crossed'
        'providers:List every action command Sweep understands'
        'diagnostics:Print platform diagnostics'
        'import:Validate a cleaner definition file or directory without running it'
        'config:Inspect and edit the configuration file (show/path/init/get/set)'
        'completions:Generate a shell completion script (bash, zsh or fish)'
        'man:Generate a roff man page (for packaging)'
    )
    _arguments -C \
        '--config[Path to the configuration file]':value \
        '--shred[Overwrite files before deleting (secure deletion), overriding the config]' \
        '--force[Allow cleaning protected system paths and the keep list (expert only)]' \
        '--trust-external[Treat cleaners loaded from disk as trusted (lets them run processes / edit the registry)]' \
        '--bleachbit[Also load BleachBits CleanerML definitions from their standard locations]' \
        '--winapp2[Also load and translate winapp2.ini]' \
        '--define[Extra directory of cleaner definitions to load]':value \
        '--json[Print machine-readable JSON instead of a human summary]' \
        '--summary[Aggregate the report\: exact per-option totals plus a bounded entry sample]' \
        '--quiet[Do not print progress bars]' \
        '--debug[Enable debug logging]' \
        '--yes[Skip the pre-clean confirmation prompt (required for non-interactive runs)]' \
        '--backup-dir[Copy files here (mirroring layout) before deleting them]':value \
        '--log-file[Append every operation to this log file]':value \
        '--portable[Portable mode\: keep config, log and hub under DIR (USB-friendly)]':value \
        '--html[Also write a standalone HTML report to this file]':value \
        '--markdown[Also write a Markdown report to this file (CI / issue friendly)]':value \
        '--help[Print help]' \
        '--version[Print version]' \
        '1:command:->command' \
        '*::arg:->args'
    case $state in
        command)
            _describe -t commands 'sweep command' _sweep_commands
            ;;
        args)
            case $words[1] in
                list)
                    _arguments '--search[Only cleaners whose id, name or description contains this text]':value \
                        '--os[Only cleaners that (also) apply to this OS (linux, macos, windows…)]':value \
                        '--running[Only cleaners whose target application is currently running]'
                    ;;
                preview)
                    _arguments '--all[Clean every active option of every applicable cleaner]' \
                        '--exclude[Exclude these `cleaner.option` selectors]':value \
                        '--last[Reuse the selection remembered by the last `--remember` run]' \
                        '--remember[Remember this selection for a later `--last` run]'
                    ;;
                clean)
                    _arguments '--all[Clean every active option of every applicable cleaner]' \
                        '--exclude[Exclude these `cleaner.option` selectors]':value \
                        '--last[Reuse the selection remembered by the last `--remember` run]' \
                        '--remember[Remember this selection for a later `--last` run]'
                    ;;
                deepscan)
                    _arguments '--pattern[Extra glob patterns (repeatable)]':value \
                        '--preview[Just list matches without deleting]'
                    ;;
                leftovers)
                    _arguments '--clean[Actually delete the leftovers (default only lists them)]' \
                        '--min-size[Only report hits at least this big (e.g. 10MB)]':value
                    ;;
                devscan)
                    _arguments '--clean[Actually delete the cruft (default only lists it)]' \
                        '--max-depth[Max recursion depth (default 6)]':value \
                        '--min-size[Only report cruft at least this big (e.g. 50MB)]':value
                    ;;
                bigfiles)
                    _arguments '--clean[Actually delete the files (default only lists them)]' \
                        '--min-size[Minimum file size (default 100MB, e.g. 500MB)]':value \
                        '--older-than[Only files older than this (e.g. 90d, 12w, 6m, 1y)]':value \
                        '--top[Show only the top N files]':value \
                        '--max-depth[Max recursion depth (default 12)]':value
                    ;;
                dupes)
                    _arguments '--clean[Actually delete duplicates, keeping the first of each group]' \
                        '--min-size[Minimum file size (default 1MB, e.g. 100KB)]':value \
                        '--max-depth[Max recursion depth (default 12)]':value
                    ;;
                schedule)
                    _arguments '--enable[Install and enable the daily timer]' \
                        '--disable[Stop and remove the timer]' \
                        '--hour[Hour of day for the run (0-23, default 3)]':value
                    ;;
                undo)
                    _arguments '--log-file[Operation log to replay (defaults to the standard log)]':value \
                        '--backup-dir[Backup root used during cleaning]':value
                    ;;
                update-winapp2)
                    _arguments '--url[Custom source URL]':value
                    ;;
                hub)
                    _arguments '--url[Custom index URL]':value
                    ;;
                analyze)
                    _arguments '--top[How many entries per section (default 15)]':value \
                        '--max-depth[Max recursion depth for the file ranking (default 8)]':value
                    ;;
                services)
                    _arguments '--user[Manage user services instead of system ones]'
                    ;;
                history)
                    _arguments '--log-file[Operation log (defaults to the standard log)]':value \
                        '--days[Only this many past days (0 = all time)]':value
                    ;;
                watch)
                    _arguments '--threshold[Usage percent that triggers an alarm (default 90)]':value \
                        '--interval[Seconds between checks (ignored with --once)]':value \
                        '--once[Check once and exit (code 3 = alarm fired)]' \
                        '--suggest[Include this many biggest files in the alarm (0 = off)]':value
                    ;;
                man)
                    _arguments '--output[Write sweep.1 into this directory instead of stdout]':value
                    ;;
            esac
            ;;
    esac
}
_sweep "$@"
